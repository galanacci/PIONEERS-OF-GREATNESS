{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pioneersofgreatness.com/schemas/founder-room.schema.json",
  "type": "object",
  "required": ["version", "title", "identity", "hub"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "title": { "const": "FOUNDER" },
    "identity": { "type": "string", "minLength": 1 },
    "hub": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "number", "label", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "number": { "type": "string", "pattern": "^[0-9]{2}$" },
          "label": { "type": "string", "minLength": 1 },
          "status": { "enum": ["development", "available"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
