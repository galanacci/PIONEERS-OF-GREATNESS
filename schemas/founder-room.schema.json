{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pioneersofgreatness.com/schemas/founder-room.schema.json",
  "type": "object",
  "required": ["version", "title", "identity", "hub", "code", "origin", "journey"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "title": { "const": "FOUNDER" },
    "identity": { "type": "string", "minLength": 1 },
    "hub": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "number", "label", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "number": { "type": "string", "pattern": "^[0-9]{2}$" },
          "label": { "type": "string", "minLength": 1 },
          "status": { "enum": ["development", "available"] }
        },
        "additionalProperties": false
      }
    },
    "code": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "required": ["number", "statement"],
        "properties": {
          "number": { "type": "string", "pattern": "^[0-9]{2}$" },
          "statement": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "origin": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "number", "title", "media"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "number": { "type": "string", "pattern": "^[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "minLength": 1 },
          "media": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["image", "video", "placeholder"] },
              "src": { "type": "string", "minLength": 1 },
              "poster": { "type": "string", "minLength": 1 },
              "alt": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "copy": {
            "type": "array",
            "minItems": 0,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "journey": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "number", "title", "media", "copy", "scene"],
        "properties": {
          "scene": {
            "type": "object",
            "required": ["position", "scale", "baseRotation", "startRotation", "idleRotationSpeed", "idleRotationDirection", "floatAmplitude", "floatSpeed", "floatPhase", "labelOffset", "focusOffset", "status"],
            "properties": {
              "position": { "$ref": "#/$defs/vector3" },
              "baseRotation": { "$ref": "#/$defs/vector3" },
              "labelOffset": { "$ref": "#/$defs/vector3" },
              "focusOffset": { "$ref": "#/$defs/vector3" },
              "scale": { "type": "number", "exclusiveMinimum": 0 },
              "startRotation": { "type": "number" },
              "idleRotationSpeed": { "type": "number", "minimum": 0 },
              "idleRotationDirection": { "enum": [-1, 1] },
              "floatAmplitude": { "type": "number", "minimum": 0 },
              "floatSpeed": { "type": "number", "minimum": 0 },
              "floatPhase": { "type": "number" },
              "status": { "enum": ["SAVED", "IN PROGRESS"] }
            },
            "additionalProperties": false
          },
          "id": { "type": "string", "minLength": 1 },
          "number": { "type": "string", "pattern": "^[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "media": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["image", "placeholder", "model"] },
              "orbit": { "type": "string", "minLength": 1 },
              "src": { "type": "string", "minLength": 1 },
              "alt": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "copy": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "vector3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
  },
  "additionalProperties": false
}
