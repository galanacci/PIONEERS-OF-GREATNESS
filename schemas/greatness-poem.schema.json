{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pioneersofgreatness.com/schemas/greatness-poem.schema.json",
  "type": "object",
  "required": ["version", "title", "placeholder", "paragraphs"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "title": { "const": "THE BEGINNING" },
    "placeholder": { "type": "boolean" },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
